pcl:Commit01 a backlog:Commitment ;
    backlog:commitsToGoal pcl:Goal_Scope .

pcl:Commit03 a backlog:Commitment ;
    backlog:commitsToGoal pcl:Goal3_Mission .

pcl:Del4_D1 a backlog:ScopeDeliverable ;
    rdfs:label "The hand-over on closing an epic is rewritten for its recipient alone and placed in the framework's own inbox, and IPage's fallback copy is retired from its pending folder"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_H_Epic ;
    backlog:derivesFromMissionClause "every open hand-over is settled and delivered to its owner's inbox"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D10 a backlog:ScopeDeliverable ;
    rdfs:label "The release gate runs, for every live lineage, the checks of the rule sets it adopted (the validator, the order check, the release-item check), so a release that moves no item and cites no dated Owner ruling fails"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Enforcement ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D11 a backlog:ScopeDeliverable ;
    rdfs:label "Every file a release changes is traced, in the register, to the item and task whose work it is, and every task names its task type"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Artifacts ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D12 a backlog:ScopeDeliverable ;
    rdfs:label "At every release a monitoring report of each live lineage (open obstacles, objectives off target, late boxes) is produced by the framework's monitor, and each deviation it names is raised as an obstacle or a finding with its route"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Monitoring ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D13 a backlog:ScopeDeliverable ;
    rdfs:label "Every backlog item of a Delivery lineage sits in one package, chosen by its recorded priority, impact and the deliverable it serves, and every deliverable is delivered by a package"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Planning ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D14 a backlog:ScopeDeliverable ;
    rdfs:label "Every sprint of a Delivery lineage plans the groomed stories of one package, and its plan names the objectives they move"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Planning ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D15 a backlog:ScopeDeliverable ;
    rdfs:label "Every story taken into a sprint is refined, and its tasks are defined, typed and planned before they start; every move of a status is recorded when it happens"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Artifacts ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D16 a backlog:ScopeDeliverable ;
    rdfs:label "Every task, story and sprint closes only with its Definition of Done proven by evidence the release gate re-verifies"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Phases ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D17 a backlog:ScopeDeliverable ;
    rdfs:label "Every sprint ends with a review that names its unfinished tasks and stories and carries them, re-ranked, into the next sprint"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Phases ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D18 a backlog:ScopeDeliverable ;
    rdfs:label "Every package and sprint has a time box whose end is a forecast, recorded with its base plan and read against the pace delivered"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Planning ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D19 a backlog:ScopeDeliverable ;
    rdfs:label "Every release deploys one or more completed packages and records why they were chosen: urgency, coverage, cohesion or business value"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Deployment ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D2 a backlog:ScopeDeliverable ;
    rdfs:label "A hand-over naming the archive tool's three flaws, with the evidence of 2026-11-08, is placed in the framework's own inbox"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_H_Archive ;
    backlog:derivesFromMissionClause "every open hand-over is settled and delivered to its owner's inbox"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D3 a backlog:ScopeDeliverable ;
    rdfs:label "The hand-over on a profile naming its own page format is settled: taken as scope of the Delivery lineage on profiles, logged, and moved out of pending"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_H_ProfileFormat ;
    backlog:derivesFromMissionClause "every open hand-over is settled and delivered to its owner's inbox"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D4 a backlog:ScopeDeliverable ;
    rdfs:label "The hand-over on page versions is settled: taken as scope of the Delivery lineage it belongs to, logged, and moved out of pending"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_H_PageVersion ;
    backlog:derivesFromMissionClause "every open hand-over is settled and delivered to its owner's inbox"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D5 a backlog:ScopeDeliverable ;
    rdfs:label "Lineage 2 is set down in the archive, on the Owner's ruling on how a lineage concluded before its items had to be closed is set down"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_Lifecycle ;
    backlog:derivesFromMissionClause "Lineage 2 is set down"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D6 a backlog:ScopeDeliverable ;
    rdfs:label "Each Delivery lineage to come is recorded in the queue (a lineage at Opened) with its mission and the carried-forward deliverables it takes, in order, the repair of the rule checks first"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_Roadmap ;
    backlog:derivesFromMissionClause "the work carried forward from Lineage 3 is laid out as a roadmap of narrow Delivery lineages, each with its package, the repair of the rule checks first"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D7 a backlog:ScopeDeliverable ;
    rdfs:label "The release gate runs the framework's order check on IPage's register, so a Delivery lineage whose stage or ceremony is missing or out of order fails the release"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Phases ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D8 a backlog:ScopeDeliverable ;
    rdfs:label "The queue of Delivery lineages records their order and the links between their items, and only one runs at a time unless the two are connected"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Order ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Del4_D9 a backlog:ScopeDeliverable ;
    rdfs:label "Each Delivery lineage has its packages chosen before its first box, a forecast from the framework's date planner discussed with the Owner before its dates are final, and a base plan for every box it opens, read against it at the box's end"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:deliverableForArea pcl:Area4_X_Planning ;
    backlog:derivesFromMissionClause "the Governance lineage governs, directs, monitors, controls, corrects and keeps on track the execution of IPage's Delivery lineages"^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Executor_ClaudeCodeSession a backlog:Executor_SingleAgent ;
    rdfs:label "Claude Code session - the AI-agent executor of this register's work"@en ;
    rdfs:comment "The party that performs this register's work: one non-human executing party with no standing team membership."^^xsd:string .


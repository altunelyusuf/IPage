    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:contributesToMission pcl:Mission ;
    backlog:decidedBy backlog:Owner ;
    backlog:derivesFromScope pcl:Scope ;
    backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    rdfs:comment "Mission clause: \"has every page template and example it ships meet those conditions\""^^xsd:string .

pcl:Goal_Conf a backlog:Goal ;

pcl:ArchiveEntry_Lineage03 a backlog:LineageArchiveEntry ;
    backlog:archivalTrigger "Retired whole by backlog_lineage_archive_v2_0_0: mission Out_Abandoned, closure report present, every item Done or Cancelled, not frozen. Everything the lineage owned -- its Lineage individual, its Mission, its closure report, its stage outputs, findings and items -- moved to the archive file; this entry is the only thing that remains, and it is a record, not a lineage (G92)." ;
    backlog:archiveFile "archive/interactive_page_lineage_abox_archive_v1_1_0.ttl" ;
    backlog:archivedAt "2026-11-08T10:33:56+00:00"^^xsd:dateTime ;
    backlog:entryForLineage pcl:Lineage03 ;
    backlog:entryForMission pcl:Mission_R2 ;
    backlog:entryOrdinal 3 ;
    backlog:entryOutcome backlog:Out_Abandoned .

pcl:Blueprint01 a backlog:Blueprint ;
    rdfs:label "Domain model: what this backlog's work is about"@en ;
    backlog:blueprintFor pcl:Backlog ;
    backlog:hasDomainEntity pcl:DomainEntity_PageConditions .

pcl:Blueprint03 a backlog:Blueprint ;
    rdfs:label "Domain model: what the work of Lineage 3 is about"@en ;
    backlog:blueprintFor pcl:Backlog ;
    backlog:hasDomainEntity pcl:DomainEntity_PageOntology .

pcl:CR_ClosureMission a backlog:ClosureReport ;
    rdfs:label "Closure report of Mission 1: replaced, nothing delivered"@en ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:citesAssessment pcl:AsIs_L2 ;
    backlog:closesForMission pcl:Mission ;
    backlog:hasClosureMark backlog:Cm_Cancelled ;
    backlog:hasClosureSummary "Mission 1 was set down on 2026-11-04 on the Owner's decision. Its five planning stages were published and no delivery work started, so nothing was delivered under it. It was replaced because it was not set properly: it left out the default page format, treated the course page as the page to prove, and was written in language the Owner found hard to read." ;
    backlog:reportGeneratedAt "2026-11-04T12:00:00+03:00"^^xsd:dateTime ;
    backlog:reportsOnObjective pcl:Obj_Conf,
        pcl:Obj_Contained,
        pcl:Obj_G1,
        pcl:Obj_G2,
        pcl:Obj_G3,
        pcl:Obj_K1,
        pcl:Obj_K2,
        pcl:Obj_P1,
        pcl:Obj_R1,
        pcl:Obj_R2,
        pcl:Obj_ScopeSat,
        pcl:Obj_X1,
        pcl:Obj_X2,
        pcl:Obj_X3,
        pcl:Obj_X4,
        pcl:Obj_X5,
        pcl:Obj_X6,
        pcl:Obj_X7 .


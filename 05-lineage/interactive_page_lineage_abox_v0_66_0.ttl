    backlog:hasStateDigest "5c33bbf5eb7c48b0907c2c9832df5f5919be731e8df41401757c9bdfecdd0e5f"^^xsd:string ;
    backlog:outputOfStage backlog:Stage_Scope ;
    backlog:outputRetracted true .

pcl:Out4_Scope2 a backlog:StageOutput ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:closedAtCommit "IPage v1.10.0 (release commit; witnessed by git, not asserted)"^^xsd:string ;
    backlog:consumesOutput pcl:Out4_Mission ;
    backlog:hasRationale "Scope stage of Lineage 4, closed in its own release; the digest is the framework's own state_digest over this stage's element types."^^xsd:string ;
    backlog:hasStateDigest "9e33c2d689e9013b4a1b77cbdb2e7064b5137e56a7aa36cbc2ebe95827b60133"^^xsd:string ;
    backlog:outputOfStage backlog:Stage_Scope ;
    backlog:outputRetracted true .

pcl:Ruling_IP3 a backlog:GovernanceRuling ;
    rdfs:label "The Governance lineage's mission is widened to the general governance of the Delivery lineages' execution"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R3"^^xsd:string ;
    backlog:hasRulingStatement "The mission of IPage's Governance lineage keeps its wording and is widened, by a mission amendment, to the general mission of governance: to govern, direct, monitor, control, correct and keep on track the execution of IPage's Delivery lineages, so that each obeys its phases, connections, enforcements, ceremonies, methodologies, artifacts, dependencies, ordering, planning, predictions and task types, and can satisfy its mission. The Scope stage, closed in 1.9.0, is rebuilt by a stage revision to answer it, and the goals are built for the widened mission. The Owner's 'production lineage' is the framework's Delivery lineage (G217)."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 about 20:30 Istanbul (17:30 UTC), answering the question on the Governance lineage's goals: 'The mission of the Governance lineage as a general is to govern, direct, monitor, control, correct, and keep in track the execution obeying the phases, connections, enforcements, ceremonies, methodologies, artifacts, dependencies, ordering, planinng, predictions, task types of the production lineage so that the production can satisfy the mission. What you need is just to adapt the current mission with general governance mission. You should build the goals for that mission.'"^^xsd:string .

pcl:Ex4_Branches a backlog:ScopeExclusion ;
    rdfs:label "Exclusion: Governance branches with no open work"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Risk, cost and speed, benefits, operating cadence, accountability and the other branches of the framework's governance taxonomy that have no open work in IPage."^^xsd:string ;
    backlog:hasExclusionRationale "They enter by change management of this lineage when work appears in them."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Ex4_Outside a backlog:ScopeExclusion ;
    rdfs:label "Exclusion: Files of other packages"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any file outside IPage, except a hand-over placed in a recipient's inbox."^^xsd:string ;
    backlog:hasExclusionRationale "Another package is changed only by its own session (OE scope discipline); a hand-over is how IPage asks."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Ex4_Product a backlog:ScopeExclusion ;
    rdfs:label "Exclusion: Product work"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Any change to the ontology, its shapes, the pages or the measurement."^^xsd:string ;
    backlog:hasExclusionRationale "Product work belongs to the Delivery lineages this lineage lays out."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work .

pcl:Metric4_A_Artifacts a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for typed, planned tasks with current statuses (D15) and traced files (D11)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_A_Phases a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for stage and ceremony order (D7), closing by the Definition of Done (D16) and sprint review with carry-over (D17)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_A_Planning a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for packages and a discussed forecast before the first box (D9), packages (D13), sprint plans (D14) and time boxes (D18)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_Branches a <http://example.org/core#Metric> ;
    rdfs:label "Work items of Lineage 4 that serve no deliverable of its scope"@en ;
    skos:definition "Counted in units of: item."@en .

pcl:Metric4_Conf a <http://example.org/core#Metric> ;
    rdfs:label "Violations of the framework's shapes on IPage's register, plus live lineages that do not hold clean"@en ;
    skos:definition "Counted in units of: violation."@en .

pcl:Metric4_Contained a <http://example.org/core#Metric> ;
    rdfs:label "Files changed since Lineage 4 opened outside the places its deliverables live in"@en ;
    skos:definition "Counted in units of: file."@en .

pcl:Metric4_Execution a <http://example.org/core#Metric> ;
    rdfs:label "Release-gate checks of the execution method that do not yet refuse a planted fault"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_H_Archive a <http://example.org/core#Metric> ;
    rdfs:label "The hand-over on the archive tool's flaws not yet in the framework's inbox"@en ;
    skos:definition "Counted in units of: hand-over."@en .

pcl:Metric4_H_Epic a <http://example.org/core#Metric> ;
    rdfs:label "The hand-over on closing an epic not yet in the framework's inbox, or a copy left in IPage's pending"@en ;
    skos:definition "Counted in units of: hand-over."@en .

pcl:Metric4_H_PageVersion a <http://example.org/core#Metric> ;
    rdfs:label "The hand-over on a page's version still pending in IPage's inbox"@en ;
    skos:definition "Counted in units of: hand-over."@en .

pcl:Metric4_H_ProfileFormat a <http://example.org/core#Metric> ;
    rdfs:label "The hand-over on a profile's own page format still pending in IPage's inbox"@en ;
    skos:definition "Counted in units of: hand-over."@en .

pcl:Metric4_Handovers a <http://example.org/core#Metric> ;
    rdfs:label "Hand-overs not settled in their own recipient's inbox"@en ;
    skos:definition "Counted in units of: hand-over."@en .

pcl:Metric4_Lifecycle a <http://example.org/core#Metric> ;
    rdfs:label "Concluded lineages still held in the live register, plus Lineage 2 if not set down"@en ;
    skos:definition "Counted in units of: lineage."@en .

pcl:Metric4_Mission a <http://example.org/core#Metric> ;
    rdfs:label "Deliverables of the Governance lineage's scope not met"@en ;
    skos:definition "Counted in units of: deliverable."@en .

pcl:Metric4_Outside a <http://example.org/core#Metric> ;
    rdfs:label "Files of the Ontologies monorepo changed by an IPage commit since Lineage 4 opened, other than a hand-over in an inbox"@en ;
    skos:definition "Counted in units of: file."@en .

pcl:Metric4_Product a <http://example.org/core#Metric> ;
    rdfs:label "Files of the ontology, its shapes, the page measure, the default format or the page measurement changed since Lineage 4 opened"@en ;
    skos:definition "Counted in units of: file."@en .

pcl:Metric4_Roadmap a <http://example.org/core#Metric> ;
    rdfs:label "No Delivery lineage queued at Opened with its mission (D6)"@en ;
    skos:definition "Counted in units of: deliverable."@en .

pcl:Metric4_X_Deploy a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for a deployment marked by a milestone, carrying completed packages and why they were chosen (D19)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Done a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for closing a task, story or sprint only on re-verified Definition of Done evidence (D16)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Monitor a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for a monitoring report of each live lineage (D12) and a deviation in it with no route to correction"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Order a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for the queue order and one Delivery lineage at a time (D8)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Packages a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for every backlog item in one package chosen on its recorded grounds (D13)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Review a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for a review of every sprint carrying its unfinished work, re-ranked, into the next (D17)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Rules a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for the rule sets every live lineage adopted (D10)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Sprints a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for a sprint planning the groomed stories of one package and naming their objectives (D14)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Tasks a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for refined stories with typed, planned tasks and every status move recorded (D15)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_TimeBox a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for a time box with a base plan and a forecast end on every package and sprint (D18)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Metric4_X_Trace a <http://example.org/core#Metric> ;
    rdfs:label "Missing: a release-gate check that refuses a planted fault for every changed file traced to its item and task (D11)"@en ;
    skos:definition "Counted in units of: check."@en .

pcl:Obj4_A_Artifacts a backlog:Objective ;
    rdfs:label "Objective: Missing: a release-gate check that refuses a planted fault for typed, planned tasks with current statuses (D15) and traced files (D11)"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:contributesToGoal pcl:Goal4_A_Artifacts ;
    backlog:fillsScope pcl:Scope4 ;
    backlog:hasAchievementStatus backlog:Ach_Pending ;
    backlog:hasBaselineValue 2.0 ;
    backlog:hasCheckpoint pcl:CP4_A_Artifacts ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:hasMeasurementKind backlog:Meas_Derived ;
    backlog:hasMeasurementQuery "python3 05-lineage/measure_governance_v1_0_0.py --metric A_Artifacts"^^xsd:string ;
    backlog:hasRationale "Baseline read by measure_governance_v1_0_0.py on IPage v1.14.0 (9d90e53); the figure counts what is still missing, so the target is 0; it is the sum of its children's figures, as the goal tree sums the scope tree. A check counts as met only when the release gate refuses a planted fault for it, never by a file or a claim."^^xsd:string,
        "Used at four moments (ruling IP-R6): driving, at each sprint plan, where the open figure helps choose the next work; monitoring, at each release, where the gate prints and records it; control, at each release, where a figure that rises is raised as an obstacle with its route to correction; closure, the last reading, where 0 is achieved and anything else is recorded as missed."^^xsd:string ;
    backlog:hasSuccessMetric pcl:Metric4_A_Artifacts ;
    backlog:hasTargetDirection backlog:Dir_Decrease ;
    backlog:hasTargetValue 0.0 ;
    backlog:producedByStage pcl:Out4_Objective ;
    prov:wasDerivedFrom pcl:Obj4_X_Tasks,
        pcl:Obj4_X_Trace .


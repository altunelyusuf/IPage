pcl:Gap_PageConditions_Suspension a backlog:BlueprintGap ;
    rdfs:label "No coverage: life-cycle stage Suspension"@en ;
    backlog:gapForEntity pcl:DomainEntity_PageConditions ;
    backlog:gapForStage backlog:Stage_SuspensionException ;
    backlog:hasGapReason "Out of scope: what happens when a page is found to fail a condition after release is handled by the ordinary release path and a new increment, not by this lineage."^^xsd:string .

pcl:Gap_PageConditions_Termination a backlog:BlueprintGap ;
    rdfs:label "No coverage: life-cycle stage Termination"@en ;
    backlog:gapForEntity pcl:DomainEntity_PageConditions ;
    backlog:gapForStage backlog:Stage_Termination ;
    backlog:hasGapReason "Out of scope: retiring the gates is not part of building them; it is decided when this lineage is achieved."^^xsd:string .

pcl:Gap_PageOntology_ActiveUse a backlog:BlueprintGap ;
    rdfs:label "No live coverage: life-cycle stage Active use"@en ;
    backlog:gapForEntity pcl:DomainEntity_PageOntology ;
    backlog:gapForStage backlog:Stage_ActiveUse ;
    backlog:hasGapReason "Covered by the work of Lineage 3, which was concluded on the Owner's ruling IP-R1 and set down in the archive on 2026-11-08 (05-lineage/archive/interactive_page_lineage_abox_archive_v1_1_0.ttl). No live lineage covers this stage until IPage's Delivery lineages take the work carried forward."^^xsd:string .


pcl:ArchiveEntry_Lineage02 a backlog:LineageArchiveEntry ;
    backlog:archivalTrigger "Retired whole by backlog_lineage_archive_v2_0_0: mission Out_Abandoned, closure report present, every item Done or Cancelled, not frozen. Everything the lineage owned -- its Lineage individual, its Mission, its closure report, its stage outputs, findings and items -- moved to the archive file; this entry is the only thing that remains, and it is a record, not a lineage (G92)." ;
    backlog:archiveFile "archive/interactive_page_lineage_abox_archive_v1_2_0.ttl" ;
    backlog:archivedAt "2026-11-08T18:06:11+00:00"^^xsd:dateTime ;
    backlog:entryForLineage pcl:Lineage02 ;
    backlog:entryForMission pcl:Mission ;
    backlog:entryOrdinal 2 ;
    backlog:entryOutcome backlog:Out_Abandoned .

pcl:ArchiveEntry_Lineage03 a backlog:LineageArchiveEntry ;

    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:deliverableForArea pcl:Area3_A8 ;
    backlog:derivesFromMissionClause "RDODI can use it to build and check its default page format"^^xsd:string ;
    backlog:hasProductScopeKind backlog:Kind_Functional ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Del3_D11 a backlog:ScopeDeliverable ;
    rdfs:label "The course page opens from a fresh clone of the release, and code edited on it changes its result"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:deliverableForArea pcl:Area3_A8 ;
    backlog:derivesFromMissionClause "RDODI can use it to build and check its default page format"^^xsd:string ;
    backlog:hasProductScopeKind backlog:Kind_NonFunctional ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Del3_D2 a backlog:ScopeDeliverable ;

        pcl:Area3_A6,
        pcl:Area3_A7,
        pcl:Area3_A8,
        pcl:Area3_A9 ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasScopeExclusion pcl:Excl3_X1,
        pcl:Excl3_X2,
        pcl:Excl3_X3,
        pcl:Excl3_X4,
        pcl:Excl3_X5,
        pcl:Excl3_X6 ;
    backlog:hasScopeStatementText "The scope has ten areas. Seven are about the ontology and its use: the kinds of page parts, the qualities a good page has, the Owner's page rules, the checks that read a page, the pages already shipped, which page each profile gets, and the default page format; one is the course page as one profile's page. Two are about the work: how changes reach users, and the hand-over to a new session. Each area has its own finish conditions; six things are out."^^xsd:string ;
    backlog:requiresDeliverable pcl:Del3_D1,
        pcl:Del3_D10,
        pcl:Del3_D11,
        pcl:Del3_D12,
        pcl:Del3_D2,
        pcl:Del3_D3,
        pcl:Del3_D4,
        pcl:Del3_D5,
        pcl:Del3_D6,
        pcl:Del3_D7,
        pcl:Del3_D8,
        pcl:Del3_D9,
        pcl:Del3_W1,
        pcl:Del3_W2,
        pcl:Del3_W3 ;
    backlog:scopeForMission pcl:Mission_R2 ;
    rdfs:comment "DRAFT by an assistant session from the Owner's words of 2026-11-04; accepted by the Owner the same day ('Yes, proceed'); not owner-worded."^^xsd:string .


    backlog:derivesFromMissionClause "carries the Owner's page rules"^^xsd:string ;
    backlog:hasProductScopeKind backlog:Kind_Functional ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Del3_D5 a backlog:ScopeDeliverable ;

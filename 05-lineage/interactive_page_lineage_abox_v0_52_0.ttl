    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:deliverableForArea pcl:Area3_A1 ;
    backlog:derivesFromMissionClause "organised by kind"^^xsd:string ;
    backlog:hasProductScopeKind backlog:Kind_Functional ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Del3_D3 a backlog:ScopeDeliverable ;

pcl:AC3_S1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the page-part classes in the ecosystem file, When the stand-alone ontology is built, Then every class stands in it, linked to at least one other, and the ecosystem file refers to it."^^xsd:string ;
    backlog:satisfiedByArtifact "the stand-alone ontology files of the package interactive-page-ontology, published in interactive-page-ontology-v1.0.1 (commit d6aa913393)"^^xsd:string .

pcl:AC3_S14 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the IPage repository, When the work is moved, Then the page ontology, Lineage 3's register and its tools sit in IPage and pass their checks from a fresh clone, and the monorepo copy of the package says it moved to IPage."^^xsd:string ;
    backlog:satisfiedByArtifact "the stand-alone ontology files of the package interactive-page-ontology, published in IPage-v1.3.1 (commit 61950a16dd)"^^xsd:string .

pcl:AC3_S15 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the recorded rules and their shapes, When a page is measured in a browser at desktop and phone width, Then the measurement lists every rule as measured with its figure, and a page known to break a rule fails it."^^xsd:string ;
    backlog:satisfiedByArtifact "the stand-alone ontology files of the package interactive-page-ontology, published in IPage-v1.4.0 (commit 9186f19)"^^xsd:string .

pcl:AC3_S2 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the stand-alone ontology, When it is read, Then every page part except the root has a parent kind and a reader can browse from a kind to its parts."^^xsd:string ;
    backlog:satisfiedByArtifact "the stand-alone ontology files of the package interactive-page-ontology, published in interactive-page-ontology-v1.0.1 (commit d6aa913393)"^^xsd:string .

pcl:AC3_S3 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the ten recorded standards and methods, When the ontology is read, Then each carries a link to the page parts it applies to."^^xsd:string ;
    backlog:satisfiedByArtifact "the stand-alone ontology files of the package interactive-page-ontology, published in interactive-page-ontology-v1.1.2 (commit 438bf1a55a)"^^xsd:string .

pcl:AC3_S4 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the Owner's recorded instructions on course pages, When the rules are collected, Then each is recorded once, with the Owner's words as source, one quality and one kind of page part, and the count is shown to the Owner."^^xsd:string ;
    backlog:satisfiedByArtifact "the stand-alone ontology files of the package interactive-page-ontology, published in interactive-page-ontology-v1.2.1 (commit 37febbe158)"^^xsd:string .

pcl:AC3_S9 a backlog:AcceptanceCriterion ;

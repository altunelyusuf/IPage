pcl:Excl_X4 a backlog:ScopeExclusion ;
    rdfs:label "The course page's own features stay as they are"@en ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Changing the course page's graded-exam layer or giving Stage 2 a slot for executed examples"^^xsd:string ;
    backlog:hasExclusionRationale "Not a clause of the mission; recorded as gaps C3 and C4 in 01-profiles/RDODI_PROFILE_AND_PAGE_GAPS_v1_0_0.md for a later decision."^^xsd:string ;

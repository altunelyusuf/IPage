pcl:Excl3_X1 a backlog:ScopeExclusion ;
    rdfs:label "Other repositories are read, never changed"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Editing the course repository, the CME repository or any other package"^^xsd:string ;
    backlog:hasExclusionRationale "The Owner allowed read access to other repositories, not changes (2026-10-28); the course page is cited by repository, commit and SHA-256."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Work ;
    rdfs:comment "From 2026-11-05 (change request CR3_Move) this lineage's home is the IPage repository; 'other repositories' means every repository except IPage."@en .

pcl:Excl3_X2 a backlog:ScopeExclusion ;
    rdfs:label "The ontology covers the page, not what a course teaches"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Modelling course subjects, chapters or exam content inside the page ontology"^^xsd:string ;
    backlog:hasExclusionRationale "The Owner asked for an ontology of interactive pages; course content already has its own ontologies."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Excl3_X3 a backlog:ScopeExclusion ;
    rdfs:label "Outside standards are cited, not rewritten"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Rewriting WCAG, Nielsen's heuristics or other published standards inside the ontology"^^xsd:string ;
    backlog:hasExclusionRationale "The ontology ties its qualities to the published standards by link and source; a copy would drift."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Excl3_X4 a backlog:ScopeExclusion ;
    rdfs:label "The course page's exam layer stays as it is"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Changing the course page's graded-exam layer or giving Stage 2 a slot for executed examples"^^xsd:string ;
    backlog:hasExclusionRationale "Not part of the mission; recorded as gaps C3 and C4 in 01-profiles/RDODI_PROFILE_AND_PAGE_GAPS_v1_0_0.md for a later decision."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Excl3_X5 a backlog:ScopeExclusion ;
    rdfs:label "No new page kinds for profiles without a run"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Building page templates for profiles that have no generated run"^^xsd:string ;
    backlog:hasExclusionRationale "The mission names the page a profile with a run gets (01-profiles/RDODI_PROFILE_AND_PAGE_GAPS_v1_0_0.md, A1)."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Excl3_X6 a backlog:ScopeExclusion ;
    rdfs:label "No measurement on real phones or offline"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Measuring on physical devices or without a network"^^xsd:string ;
    backlog:hasExclusionRationale "Gap C6 records it as not measured; the gates measure in a browser at phone width."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Excl_X1 a backlog:ScopeExclusion ;
    rdfs:label "No new page kinds for Roadmap-Report and Whitepaper"@en ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Building page templates for the Roadmap-Report and Whitepaper profiles"^^xsd:string ;
    backlog:hasExclusionRationale "Checked fact: 01-profiles/RDODI_PROFILE_AND_PAGE_GAPS_v1_0_0.md (A1) records that these two profiles have no generated run, and the Charter asks for an exemplar over a run; the mission only names the page a profile with a run gets."^^xsd:string ;
    backlog:hasScopeLayer backlog:Layer_Product .

pcl:Excl_X2 a backlog:ScopeExclusion ;
    rdfs:label "No new page template for Technical-Report"@en ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:decidedBy backlog:Owner ;
    backlog:excludesConcern "Building a page template for the Technical-Report profile"^^xsd:string ;

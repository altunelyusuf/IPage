pcl:It3_S5 a backlog:Iteration ;
    rdfs:label "Iteration: S5"@en ;
    backlog:belongsToLineage pcl:Lineage03 ;
    backlog:hasIdentifier "RDPO-IT-S5"^^xsd:string ;
    backlog:hasRationale "Not finished in this lineage. Its 28 shapes were built (commit 467bf0e), but the three independent reviews of 2026-11-08 found that they never refuse a page in the project's own checks (they select their targets by SPARQL, which the validator applies only in its advanced mode, never switched on here) and that a refused page's report does not name the rule. Lineage 3 is concluded on the Owner's ruling IP-R1; the repair is carried forward, first in order, to a narrow Delivery lineage."^^xsd:string ;
    backlog:hasState backlog:Cancelled ;
    backlog:hasTitle "Work on S5"@en ;
    backlog:iterationStart "2026-11-05T09:54:06+00:00"^^xsd:dateTime ;
    backlog:memberOfContainer pcl:Backlog .


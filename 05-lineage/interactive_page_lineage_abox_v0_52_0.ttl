    backlog:fitsObjective pcl:Obj3_A11,
        pcl:Obj3_A1a,
        pcl:Obj3_A1b,
        pcl:Obj3_A1c,
        pcl:Obj3_A2,
        pcl:Obj3_A3a,
        pcl:Obj3_A3b,
        pcl:Obj3_A3c,
        pcl:Obj3_A4b,
        pcl:Obj3_A7a,
        pcl:Obj3_A7b,
        pcl:Obj3_Conf,
        pcl:Obj3_Contained,
        pcl:Obj3_Mission,
        pcl:Obj3_X1,
        pcl:Obj3_X2,
        pcl:Obj3_X3,
        pcl:Obj3_X4,
        pcl:Obj3_X5,

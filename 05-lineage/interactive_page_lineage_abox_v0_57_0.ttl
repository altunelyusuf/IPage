    rdfs:comment "A story is Done when its deliverable's condition holds on the pages as measured by the gate from a fresh clone of the published release, with evidence the framework's bridge re-verifies."^^xsd:string .

pcl:Scope a backlog:ScopeStatement ;
    rdfs:label "Scope: the page conditions of RDODI"@en ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:coversArea pcl:Area_A1,
        pcl:Area_A2,
        pcl:Area_A3,
        pcl:Area_A4,
        pcl:Area_A5 ;
    backlog:hasIntentOrigin backlog:IOrigin_SessionDrafted ;
    backlog:hasScopeExclusion pcl:Excl_X1,
        pcl:Excl_X2,
        pcl:Excl_X3,
        pcl:Excl_X4,
        pcl:Excl_X5,
        pcl:Excl_X6,
        pcl:Excl_X7 ;
    backlog:hasScopeStatementText "The scope is the verified gaps of 01-profiles/RDODI_PROFILE_AND_PAGE_GAPS_v1_0_0.md that the mission names: the Owner's page conditions as Stage 4 gates (with a shape and a browser measurement), their effect on every page template and example the package ships, what each profile with a generated run requires of its page, and one chapter page built here from the pinned course page. Scope is tested against the framework's own taxonomy: layer (product or work) by kind (functional or non-functional); every mission clause has a deliverable. Other repositories are only read."^^xsd:string ;
    backlog:requiresDeliverable pcl:Del_D1,
        pcl:Del_D2,
        pcl:Del_D3,
        pcl:Del_D4,
        pcl:Del_D5,
        pcl:Del_D6,
        pcl:Del_D7,
        pcl:Del_W1 ;
    backlog:scopeForMission pcl:Mission ;
    rdfs:comment "DRAFT by an assistant session; the Owner accepted the recommendation of 2026-11-02 (gap analysis, section E); not owner-worded."^^xsd:string .

pcl:Backlog a backlog:Backlog ;
    rdfs:label "RDODI page-conditions backlog"@en ;
    backlog:appliesDefinitionOfDone pcl:DoD ;
    backlog:hasCommitment pcl:Commit01,
        pcl:Commit03 ;
    backlog:hasIdentifier "RDPC-BL"^^xsd:string ;
    backlog:hasState backlog:InProgress ;
    backlog:hasTitle "RDODI page conditions"@en ;
    backlog:isRegisterRoot true .


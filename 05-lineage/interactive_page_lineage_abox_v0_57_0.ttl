pcl:Out_Backlog a backlog:StageOutput ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:closedAtCommit "rdodi-ecosystem-v1.238.0 (tag; witnessed by git, not asserted)"^^xsd:string ;
    backlog:consumesOutput pcl:Out_Objective ;
    backlog:hasRationale "Backlog stage of Lineage 2, closed in its own release; the digest is the framework's own state_digest over this stage's element types."^^xsd:string ;
    backlog:hasStateDigest "54ef1db1c4660d1819699694a0ead1ee6a2b0d63c9d833903f32257b44a79486"^^xsd:string ;
    backlog:outputOfStage backlog:Stage_Backlog .

pcl:Profile a backlog:AdoptionProfile ;
    rdfs:label "RDODI page conditions - adoption profile"@en ;
    backlog:adoptsFacet backlog:AuditFacet,
        backlog:CoreFacet,
        backlog:EvidenceFacet,
        backlog:InvariantFacet ;
    backlog:bindsNamespace "http://example.org/rdodi/page-conditions-lineage#"^^xsd:string ;
    backlog:decidedBy backlog:Owner ;
    backlog:governsBacklog pcl:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasDecisionRationale "L1_Core because the chain is still being built and no work exists yet; target L3_Governed because every objective is a re-runnable measurement and the gates this lineage builds are the evidence. These values were PROPOSED by the session; the Owner accepted the recommendation of 2026-11-02 and has named no different values. The review date is the point to change them."^^xsd:string ;
    backlog:hasLevelReviewDate "2026-12-02T00:00:00"^^xsd:dateTime ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:profileAppliesTo "The lineage that makes the Owner's page conditions rules RDODI enforces."^^xsd:string .

pcl:Ruling_IP1 a backlog:GovernanceRuling ;
    rdfs:label "IPage adopts the governance and delivery lineages of the framework: Lineage 3 is concluded and its open work is carried forward to narrow new lineages"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R1"^^xsd:string ;
    backlog:hasRulingStatement "IPage is run as the framework now runs a package: one Governance lineage that looks after how IPage's lineages live (obstacles, hand-overs, the rule sets a lineage adopts), and narrow Delivery lineages that build the product, each scoped to its smallest closeable slice and planned in packages. Lineage 3, broad and opened before the package rules, is not cut down in place (a mission is only widened): its open stories, epics, task and iteration are cancelled with a reason, an as-is assessment and a closure report marked cancelled are written, the Owner confirms the closure, the mission outcome is set, and the lineage is set down in the next release (G215). What it delivered stays Done; what it did not deliver is carried forward as scope of the new lineages. Lineage 2, already concluded on 2026-11-04, is set down in the same release. The Governance lineage opens after Lineage 3 is concluded; the Delivery lineages open one at a time."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 10:49 Istanbul (07:49 UTC): 'Adapt the package based new BRSF with governance and production lineages. Let's discuss later.' Owner, 2026-11-08 11:32 Istanbul (08:32 UTC), choosing option 1 of the three put to him (close Lineage 3 and carry the rest forward; keep it as the Delivery lineage; keep it open but paused): '1 is the cleanest option. Let's proceed in this option.'"^^xsd:string .

pcl:Ruling_IP2 a backlog:GovernanceRuling ;
    rdfs:label "The Owner confirms the closure of Lineage 3"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R2"^^xsd:string ;
    backlog:hasRulingStatement "The Owner confirmed the closure report of Lineage 3 (marked Cancelled: concluded on his ruling IP-R1, its open work carried forward); the mission outcome is set to Abandoned with the closure summary as its rationale, and the lineage status to Abandoned. The lineage is set down in the next release."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 about 13:27 Istanbul (10:27 UTC), answering the closing question on the closure report of Lineage 3 committed in 98c1704 and corrected in 725a424: 'Confirm the closure (Recommended)'."^^xsd:string .

pcl:ScopeChange_CourseNotDefault a backlog:ScopeChange ;
    rdfs:label "The course page becomes one profile's page"@en ;
    backlog:admitsItem pcl:S9 ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:changesScope pcl:Scope ;
    backlog:decidedBy backlog:Owner ;
    backlog:fulfillsRequest pcl:CR_CourseNotDefault ;
    backlog:hasScopeChangeRationale "Owner, 2026-11-04: accepted both change requests and one replacement mission (\"Yes, one mission is rational\"; \"Yes, proceed\"), after proposing that the interactive page needs a stand-alone ontology, organised by kind, which RDODI consumes, built by this lineage and then handed to a new session. Traded: the earlier chain (never started) is set aside at the cost of five planning releases." .

pcl:ScopeChange_DefaultPageFormat a backlog:ScopeChange ;
    rdfs:label "The default page format is admitted"@en ;
    backlog:admitsItem pcl:S9 ;
    backlog:belongsToLineage pcl:Lineage02 ;
    backlog:changesScope pcl:Scope ;
    backlog:decidedBy backlog:Owner ;
    backlog:fulfillsRequest pcl:CR_DefaultPageFormat ;
    backlog:hasScopeChangeRationale "Owner, 2026-11-04: accepted both change requests and one replacement mission (\"Yes, one mission is rational\"; \"Yes, proceed\"), after proposing that the interactive page needs a stand-alone ontology, organised by kind, which RDODI consumes, built by this lineage and then handed to a new session. Traded: the earlier chain (never started) is set aside at the cost of five planning releases." .


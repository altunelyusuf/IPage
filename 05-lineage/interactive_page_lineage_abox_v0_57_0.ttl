<http://example.org/rdodi/page-conditions-lineage/register> a owl:Ontology ;
    rdfs:comment "BRSF register of Lineage 3 (one ontology of interactive pages), kept in the IPage repository from 2026-11-05. Its first version here is every statement of Lineage 3 in the RDODI register rdodi_overview_page_lineage_abox_v0_39_0.ttl, published by the Ontologies monorepo commit d3c1c30028cc48830c2b391c9be8e89dd15765cb, copied unchanged; that register keeps the whole history, and the evidence recorded there is re-run against the monorepo. From here the lineage writes only to this file."@en ;
    owl:imports <http://example.org/backlog> ;
    owl:priorVersion <http://example.org/rdodi/page-conditions-lineage/register/0.54.0> ;
    owl:versionIRI <http://example.org/rdodi/page-conditions-lineage/register/0.57.0> ;
    owl:versionInfo "0.57.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

pcl:AC_S1 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the Owner's seven page conditions, When the procedure and the package's shapes file are read, Then each condition is a live Stage 4 gate row and a page-condition shape."^^xsd:string .

pcl:AC_S2 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given any page, When the instrument opens it at 1280 and 375 px, Then it reports each of the seven conditions and refuses a page that fails one, naming the condition."^^xsd:string .

pcl:AC_S3 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the nine shipped pages, When the instrument runs on each, Then every page passes or is retired by a recorded decision."^^xsd:string .

pcl:AC_S4 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the profiles with a generated run, When the page-selection register is read, Then each is linked to a page or carries a statement that none exists."^^xsd:string .

pcl:AC_S5 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a profile that claims a page, When that page fails a condition the profile requires, Then the shape refuses the claim."^^xsd:string .

pcl:AC_S6 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the pinned course page, When one chapter page is built in this package, Then every gate passes on it."^^xsd:string .

pcl:AC_S7 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a fresh clone of the release, When the chapter page is opened and a code example is edited and run, Then the shown result changes."^^xsd:string .

pcl:AC_S8 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given a published release, When the measurements are re-run from a fresh clone, Then they equal the figures recorded for that release."^^xsd:string .

pcl:AC_S9 a backlog:AcceptanceCriterion ;
    backlog:hasGherkinText "Given the Owner decided on 2026-11-04, When the register is read, Then both change requests are Accepted, Mission 2 supersedes the old mission, and the old lineage is closed as abandoned." .

pcl:AsIs_L2 a backlog:AsIsAssessment ;
    rdfs:label "As-is assessment of Lineage 2 on the day it was set down"@en ;
    backlog:assessedAt "2026-11-04T12:30:00+03:00"^^xsd:dateTime ;
    backlog:assessesLineage pcl:Lineage02 ;
    backlog:dueItem pcl:Epic_E1,
        pcl:Epic_E2,
        pcl:Epic_E3,
        pcl:Epic_E4,
        pcl:Epic_E5,

        pcl:Area4_X_Phases,
        pcl:Area4_X_Planning ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:hasScopeExclusion pcl:Ex4_Branches,
        pcl:Ex4_Outside,
        pcl:Ex4_Product ;
    backlog:hasScopeStatementText "Rebuilt by the second stage revision for the mission as amended and the execution method the Owner stated on 2026-11-08. Four areas, as a tree: (1) hand-overs, with four children (closing an epic, to the framework; the archive tool's flaws, to the framework; a profile naming its own page format, from RDODI; a page's version following the page, from a course-management session); (2) the lineage lifecycle: Lineage 2 set down; (3) planning: the Delivery lineages that carry Lineage 3's work forward, in order, each with its package; (4) the execution of the Delivery lineages, with seven children (phases and ceremonies; ordering, dependencies and connections; planning and predictions; enforcements and methodologies; artifacts and task types; monitoring and correction; deployment). Nineteen deliverables. Three exclusions, accepted by the Owner with the mission: no product work, no file outside IPage except a hand-over in a recipient's inbox, and no governance branch without open work."^^xsd:string ;
    backlog:producedByStage pcl:Out4_Scope3 ;
    backlog:requiresDeliverable pcl:Del4_D1,
        pcl:Del4_D10,
        pcl:Del4_D11,
        pcl:Del4_D12,
        pcl:Del4_D13,
        pcl:Del4_D14,
        pcl:Del4_D15,
        pcl:Del4_D16,
        pcl:Del4_D17,
        pcl:Del4_D18,
        pcl:Del4_D19,
        pcl:Del4_D2,
        pcl:Del4_D3,
        pcl:Del4_D4,
        pcl:Del4_D5,
        pcl:Del4_D6,
        pcl:Del4_D7,
        pcl:Del4_D8,
        pcl:Del4_D9 ;
    backlog:scopeForMission pcl:Mission_G4 .

pcl:Mission_G4 a backlog:Mission ;
    rdfs:label "Mission 4: IPage's lineages are governed so the next Delivery lineage opens on a clear plan"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    backlog:hasMissionOutcome backlog:Out_InFlight ;
    backlog:hasMissionStatement "IPage's lineages are governed so the next Delivery lineage opens on a clear plan: every open hand-over is settled and delivered to its owner's inbox, Lineage 2 is set down, and the work carried forward from Lineage 3 is laid out as a roadmap of narrow Delivery lineages, each with its package, the repair of the rule checks first."^^xsd:string ;
    backlog:missionFor pcl:Backlog ;
    backlog:missionSource "Owner, 2026-11-08 16:05 Istanbul (13:05 UTC): 'Accept (Recommended)' to this mission, drafted by the session and put to him with its scope (the open hand-overs; setting down Lineage 2; the Delivery roadmap) and its exclusions (no change to the ontology, shapes or pages; no file outside IPage except hand-overs placed in a recipient's inbox), under his ruling IP-R1 of the same day."^^xsd:string ;
    backlog:producedByStage pcl:Out4_Mission ;
    rdfs:comment "DRAFT by an assistant session; accepted by the Owner on 2026-11-08 as worded."@en .


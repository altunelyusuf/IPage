    backlog:areaMeasure "Counted 2026-11-08: 1 hand-over in IPage's pending folder addressed to the framework; 0 in the framework's own inbox."^^xsd:string ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:hasParentItem pcl:Area4_Handovers ;
    backlog:hasScopeLayer backlog:Layer_Work .


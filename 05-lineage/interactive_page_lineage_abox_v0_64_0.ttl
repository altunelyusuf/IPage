    rdfs:label "Area: The archive tool's flaws found on 2026-11-08: it reads the register header as text, writes 'Achieved' for an abandoned mission, and cannot set down a lineage concluded before its items had to be closed"@en ;
    backlog:areaLocation "07-handover-inbox/"^^xsd:string ;
    backlog:areaMeasure "Counted 2026-11-08: 3 flaws recorded in IPage's changelogs 1.7.0 and in the register; 0 hand-overs written."^^xsd:string ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:hasParentItem pcl:Area4_Handovers ;
    backlog:hasScopeLayer backlog:Layer_Work .


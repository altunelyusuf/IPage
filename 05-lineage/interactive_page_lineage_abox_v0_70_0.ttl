pcl:Epic4_Execution a backlog:Epic ;
    rdfs:label "The release gate keeps every Delivery lineage to the execution method"@en ;
    backlog:appliesDefinitionOfDone pcl:DoD4 ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:coversEntity pcl:DomainEntity_DeliveryLineage ;
    backlog:coversStage backlog:Stage_ActiveUse ;
    backlog:decomposesInto pcl:Epic4_X_Artifacts,
        pcl:Epic4_X_Deployment,
        pcl:Epic4_X_Enforcement,
        pcl:Epic4_X_Monitoring,
        pcl:Epic4_X_Order,
        pcl:Epic4_X_Phases,
        pcl:Epic4_X_Planning ;
    backlog:hasExecutionModality backlog:Mode_Automated ;
    backlog:hasIdentifier "IPG4-E-Execution"^^xsd:string ;
    backlog:hasInvestmentCategory backlog:Cat_Maintenance ;
    backlog:hasPriorityScore pcl:Score4_Execution_RollUp1 ;
    backlog:hasState backlog:Proposed ;
    backlog:hasTitle "The release gate keeps every Delivery lineage to the execution method"@en ;
    backlog:memberOfContainer pcl:Backlog ;
    backlog:pursuesObjective pcl:Obj4_Execution ;
    backlog:responsible pcl:Run4_Builder0 ;
    rdfs:comment "Correction, 2026-11-10: it carried 'not yet scoreable' until its child epics were groomed; its score is now the roll-up of theirs (G229)."@en .

pcl:Epic4_Handovers a backlog:Epic ;
    rdfs:label "Hand-overs are settled in their recipients' inboxes"@en ;
    backlog:appliesDefinitionOfDone pcl:DoD4 ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:coversEntity pcl:DomainEntity_DeliveryLineage ;
    backlog:coversStage backlog:Stage_ActiveUse ;
    backlog:decomposesInto pcl:Story4_D1,
        pcl:Story4_D2,
        pcl:Story4_D3,
        pcl:Story4_D4 ;
    backlog:hasConfidence 0.8 ;
    backlog:hasEffort 4.0 ;
    backlog:hasExecutionModality backlog:Mode_Automated ;
    backlog:hasIdentifier "IPG4-E-Handovers"^^xsd:string ;
    backlog:hasImpact 3.0 ;
    backlog:hasInvestmentCategory backlog:Cat_Maintenance ;
    backlog:hasPriorityScore pcl:Score4_Handovers_Est,
        pcl:Score4_Handovers_RollUp1 ;
    backlog:hasRationale "Estimated value before grooming (ruling IP-R7): reach is the number of Delivery lineages the work reaches (1 to 5), impact its business value (1 to 5), confidence low while the epic is coarse, effort a rough count of points; score = reach x impact x confidence / effort. After each grooming step the score is collected from its stories."^^xsd:string ;
    backlog:hasReach 2.0 ;
    backlog:hasState backlog:Proposed ;
    backlog:hasTitle "Hand-overs are settled in their recipients' inboxes"@en ;
    backlog:memberOfContainer pcl:Backlog ;
    backlog:pursuesObjective pcl:Obj4_Handovers ;
    backlog:responsible pcl:Run4_Builder0 ;
    backlog:satisfiesDeliverable pcl:Del4_D1,
        pcl:Del4_D2,
        pcl:Del4_D3,
        pcl:Del4_D4 ;
    rdfs:comment "Correction, 2026-11-10: the estimated score recorded in IPage 1.16.0 as a bare number is now a score record with the same value, method and time, so that the roll-up of its stories can replace it (G229)."@en .


pcl:Profile a backlog:AdoptionProfile ;
    rdfs:label "RDODI page conditions - adoption profile"@en ;
    backlog:adoptsFacet backlog:AuditFacet,
        backlog:CoreFacet,
        backlog:EvidenceFacet,
        backlog:InvariantFacet ;
    backlog:bindsNamespace "http://example.org/rdodi/page-conditions-lineage#"^^xsd:string ;
    backlog:decidedBy backlog:Owner ;
    backlog:governsBacklog pcl:Backlog ;
    backlog:hasConformanceLevel backlog:L1_Core ;
    backlog:hasDecisionRationale "L1_Core because the chain is still being built and no work exists yet; target L3_Governed because every objective is a re-runnable measurement and the gates this lineage builds are the evidence. These values were PROPOSED by the session; the Owner accepted the recommendation of 2026-11-02 and has named no different values. The review date is the point to change them."^^xsd:string ;
    backlog:hasLevelReviewDate "2026-12-02T00:00:00"^^xsd:dateTime ;
    backlog:hasTargetConformanceLevel backlog:L3_Governed ;
    backlog:profileAppliesTo "The lineage that makes the Owner's page conditions rules RDODI enforces."^^xsd:string .

pcl:Ruling_IP1 a backlog:GovernanceRuling ;
    rdfs:label "IPage adopts the governance and delivery lineages of the framework: Lineage 3 is concluded and its open work is carried forward to narrow new lineages"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R1"^^xsd:string ;
    backlog:hasRulingStatement "IPage is run as the framework now runs a package: one Governance lineage that looks after how IPage's lineages live (obstacles, hand-overs, the rule sets a lineage adopts), and narrow Delivery lineages that build the product, each scoped to its smallest closeable slice and planned in packages. Lineage 3, broad and opened before the package rules, is not cut down in place (a mission is only widened): its open stories, epics, task and iteration are cancelled with a reason, an as-is assessment and a closure report marked cancelled are written, the Owner confirms the closure, the mission outcome is set, and the lineage is set down in the next release (G215). What it delivered stays Done; what it did not deliver is carried forward as scope of the new lineages. Lineage 2, already concluded on 2026-11-04, is set down in the same release. The Governance lineage opens after Lineage 3 is concluded; the Delivery lineages open one at a time."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 10:49 Istanbul (07:49 UTC): 'Adapt the package based new BRSF with governance and production lineages. Let's discuss later.' Owner, 2026-11-08 11:32 Istanbul (08:32 UTC), choosing option 1 of the three put to him (close Lineage 3 and carry the rest forward; keep it as the Delivery lineage; keep it open but paused): '1 is the cleanest option. Let's proceed in this option.'"^^xsd:string .

pcl:Ruling_IP2 a backlog:GovernanceRuling ;
    rdfs:label "The Owner confirms the closure of Lineage 3"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R2"^^xsd:string ;
    backlog:hasRulingStatement "The Owner confirmed the closure report of Lineage 3 (marked Cancelled: concluded on his ruling IP-R1, its open work carried forward); the mission outcome is set to Abandoned with the closure summary as its rationale, and the lineage status to Abandoned. The lineage is set down in the next release."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 about 13:27 Istanbul (10:27 UTC), answering the closing question on the closure report of Lineage 3 committed in 98c1704 and corrected in 725a424: 'Confirm the closure (Recommended)'."^^xsd:string .

pcl:Ruling_IP4 a backlog:GovernanceRuling ;
    rdfs:label "The execution method the Governance lineage keeps IPage's Delivery lineages to, and the goals built from it"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R4"^^xsd:string ;
    backlog:hasRulingStatement "A Delivery lineage of IPage builds its packages from selected backlog items; develops them in sprints whose stories are the groomed backlog items, each sprint planned to match its package's coverage and objectives; in each sprint refines its stories and defines, plans and executes their tasks (SDLC definition and planning, modeling and other task types), keeping their statuses current; closes tasks, stories and sprints only when their Definition of Done is proven; reviews every sprint, so unfinished tasks and stories become the subject of the next sprints; time-boxes packages and sprints; and deploys one or more completed packages, chosen by urgency, coverage, cohesion and business value. The Governance lineage's goals are built from this method, and its scope is rebuilt (stage revision 2) to carry the deliverables the method needs."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 about 20:45 Istanbul (17:45 UTC), answering the question on the goals: 'Packages will be built out of selected PBI's and will be develeped by sprints whose stories will be groumden version of PBI's, sprint plans should match with the package coverage and objectives, sprints will be done refining the user stories, defining and planning SDLC, modeling, and other types of tasks, sprints will run to execute these tasks keeping their statuses up to date, and tasks, stories, and sprints will be closed proving the definition of done conditions are met, sprints will be reviewed to identify unfinished tasks or stories, and they would be the subject of the next sprints, packages and sprints are time boxed, deployment can be done for one or more completed packages, depending on the conditions for urgency, coverage, cohesion, and business value.' Then, about 20:50 Istanbul, 'Accept (Recommended)' to the goals rebuilt from that method."^^xsd:string .

pcl:Ruling_IP5 a backlog:GovernanceRuling ;
    rdfs:label "Lineage 2 is closed completely: its open items are cancelled before it is set down"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R5"^^xsd:string ;
    backlog:hasRulingStatement "A lineage is closed only when its items are closed or no longer alive: a precondition the framework has held since September (its archive rule, revision 2.1.0), not a rule that came after Lineage 2 was set down on 2026-11-04. Lineage 2's five epics and nine stories, left Proposed at that time, are cancelled with their reason and a recorded move, a new as-is assessment sorts them, its closure report names every cancelled item, and the lineage is set down in the archive in the next release. The session's statement of 2026-11-08 that Lineage 2 was concluded before the framework required its items closed, and that closing them would change a closed lineage, was wrong; it is corrected here."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-08 21:03 Istanbul (18:03 UTC): 'No, a lineage closure requires as pre condition, the items should be closed or not alive at all. This is not a new rule, one of the oldest rule of BRSF. Do the work properly and close the Lineage completely.'"^^xsd:string .

pcl:Ruling_IP6 a backlog:GovernanceRuling ;
    rdfs:label "The Governance lineage's goals and objectives follow the taxonomy of its scope; checkpoints wait on conditions, not dates; every objective is read for driving, monitoring, control and closure"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R6"^^xsd:string ;
    backlog:hasRulingStatement "Planned dates are forecasts and carry no due date without a known reason, so each objective's checkpoint waits on the condition that its deliverables are met, and the forecast is kept as information only. The scope is taxonomic, so goals and objectives follow its tree: each scope area has its own goal (the method goals of the Owner's ruling IP-R4 sit under the area they serve; an area served by one method goal has that goal as its own), and each node of the goal tree has an objective, a parent's figure being the sum of its children's. Objectives need not be one-to-one with goals by rule, only matching the tree. Every objective counts what is still missing, read by a script from the register, the files and the release gate, and each figure is used at four moments: driving (each sprint plan: the open counts choose the next work), monitoring (each release: the gate prints and records every figure), control (each release: the guards must read 0 or the release stops; a rising figure is raised as an obstacle with a route to correction) and closure (the last reading: all 0 is achieved, anything else is recorded as missed). The lineage's experience of this phase and its correction is handed over to the framework."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-09, answering the questions on the objectives: at about 12:55 Istanbul, 'Why do you set a date? All dates are predictive and cannot be treated as due to if there is no known reasoning. Objectives vs. goals vs. scope can be but need not be one-to-one. Scope is taxonomic, so the goals and objectives should be matching. Another concern is about measures, how and with which metrics are we going to measure the objectives, what is the correct timing to do them for various usages: monitoring, control, driving, and closure?'; at 13:15 Istanbul (10:15 UTC), choosing to proceed with the goals revised to mirror the scope tree and condition-based objectives with the four timings: '1 is fine. Just I need you build a handover and tell BRSF about our experiences and how we corrected the work in this phase.'; at 13:32 Istanbul (10:32 UTC), shown that the adopted planned-dates rule keeps a forecast date beside each condition, labelled due on nothing, and the forecast of 48 points ending about 19:00 UTC on 10 Nov: 'Record and release (Recommended)'."^^xsd:string .

pcl:Ruling_IP7 a backlog:GovernanceRuling ;
    rdfs:label "Epics are defined in the Backlog stage with an estimated value, groomed into stories before packages, and their score is then collected from their stories at the end of each grooming step"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R7"^^xsd:string ;
    backlog:hasRulingStatement "Epics are high-level backlog items defined in the Backlog stage from the scope. Before packages are chosen they are groomed into stories, to understand the scope and the business value; going from epics straight to packages leaves a gap between scope, backlog and roadmap. An epic carries an estimated value before grooming; after each grooming step its priority score is collected from its stories' scores and replaces the previous one. Recording a collected score beside scored stories, and the replacement of a score, wait on the framework (two hand-overs of 2026-11-09)."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-09: at 13:55 Istanbul, 'Epics are a high level PBI needs grooming. Your Epic to package conversion is totally wrong and a clear drift from the methodology. Epics are generated or defined during the backlog stage. In roadmap stage they should be groomed at least to understand the scope and their business value. Jumping from epics to packages, means there is a gap between scope to backlog and roadmap. Review your methodology first.'; at 16:52, 'I think we can settle it with assigning a value before the grooming and after that, the story valuations whould be collected to finalize the EPIC priority score accordingly. If the grooming takes some steps, at the end of each step we can update EPIC appropriately. What do you say?'; at 16:57 (13:57 UTC), 'Yes, this is fine. Let's proceed.'"^^xsd:string .

pcl:Ruling_IP8 a backlog:GovernanceRuling ;
    rdfs:label "Packages are planned in the roadmap work from groomed, prioritised, cohesive stories; they are not counted from epics or stories alone"@en ;
    backlog:enforcedByShape backlog:OwnerRulingDatedShape ;
    backlog:hasRulingIdentifier "IP-R8"^^xsd:string ;
    backlog:hasRulingStatement "Packages are a subject of planning and are defined after the backlog is groomed: prioritised, cohesive stories are packed into deployable packages, which is roadmap work; they are presented before the roadmap as its ingredient. In special cases a package may sit directly in the backlog (well-groomed, well-scoped work, for example inherited from earlier lineages), and grooming may continue after the roadmap as lower-priority work comes into focus, near-term work planned finely and the middle and long term in general. The number of packages is not counted from epics, stories or their combination without the prioritisation. This flexibility is why lineages run adaptively rather than in fixed steps."^^xsd:string ;
    backlog:rulingSource "Owner, 2026-11-09, answering the session's two questions at 18:05 Istanbul (15:05 UTC): 'Packages are subject of planning and can only be defined after grooming the backlog. So, they can be presented before the roadmap as an ingredient of the roadmap. But, in special cases they can be directly part of the backlog, well groomed, nicely scoped work, possibly as a heritage from legacy or previous lineages, and even after the roadmap, as grooming can proceed as lower priority work becomes gets into the focus and as result of granular planning for near term and general planning of middle and long term. This is one of the reasons why we have switched from fixed step based to flexible adaptable lineage approach.' and 'We have prioritization and cohesive stories should be packed to build a deployable packages. Packages cannot be counted with epics or stories or their combinations without the prioritization. This is the roadmap work.'"^^xsd:string .

pcl:SRev4_1 a backlog:StageRevision ;
    rdfs:label "First stage revision of Lineage 4: the Scope stage is rebuilt to answer the widened mission"@en ;
    backlog:decidedBy backlog:Owner ;
    backlog:retractsOutput pcl:Out4_Scope ;
    backlog:revisesFromStage backlog:Stage_Scope ;
    backlog:revisesLineage pcl:Lineage04 ;
    backlog:revisionReason "The Scope stage closed in 1.9.0 answered only the open governance work of the day. The Owner widened the mission the same day (ruling IP-R3, amendment MA4_1) to the general governance of the Delivery lineages' execution, which that scope does not reach. Nothing below the Scope stage had been built."^^xsd:string .

pcl:SRev4_2 a backlog:StageRevision ;
    rdfs:label "Second stage revision of Lineage 4: the Scope stage carries the deliverables of the execution method"@en ;
    backlog:decidedBy backlog:Owner ;
    backlog:retractsOutput pcl:Out4_Scope2 ;
    backlog:revisesFromStage backlog:Stage_Scope ;
    backlog:revisesLineage pcl:Lineage04 ;
    backlog:revisionReason "The Owner stated on 2026-11-08 (ruling IP-R4) the execution method the Delivery lineages are kept to; the scope of the first revision does not name its deliverables (sprints planned to packages, task work, closing by the Definition of Done, sprint review and carry-over, time boxes, deployment of completed packages). Nothing below the Scope stage had been built."^^xsd:string .

pcl:SRev4_3 a backlog:StageRevision ;
    rdfs:label "Third stage revision of Lineage 4: the goals follow the scope tree"@en ;
    backlog:decidedBy backlog:Owner ;
    backlog:retractsOutput pcl:Out4_Goal ;
    backlog:revisesFromStage backlog:Stage_Goal ;
    backlog:revisesLineage pcl:Lineage04 ;
    backlog:revisionReason "The Owner ruled on 2026-11-09 (IP-R6) that goals and objectives follow the taxonomy of the scope. The goals of 2026-11-08 follow the eleven steps of the execution method: three execution areas (phases, planning, artifacts) are served by two or three method goals with no goal of their own, and the four hand-over areas share one goal. Goals are added for those seven areas and the method goals are placed under them; nothing below the Goal stage had been recorded (the objectives were a draft shown to the Owner)."^^xsd:string .

<http://example.org/rdodi/page-conditions-lineage/register> a owl:Ontology ;
    rdfs:comment "BRSF register of Lineage 3 (one ontology of interactive pages), kept in the IPage repository from 2026-11-05. Its first version here is every statement of Lineage 3 in the RDODI register rdodi_overview_page_lineage_abox_v0_39_0.ttl, published by the Ontologies monorepo commit d3c1c30028cc48830c2b391c9be8e89dd15765cb, copied unchanged; that register keeps the whole history, and the evidence recorded there is re-run against the monorepo. From here the lineage writes only to this file."@en ;
    owl:imports <http://example.org/backlog> ;
    owl:priorVersion <http://example.org/rdodi/page-conditions-lineage/register/0.69.0> ;
    owl:versionIRI <http://example.org/rdodi/page-conditions-lineage/register/0.70.0> ;
    owl:versionInfo "0.70.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .


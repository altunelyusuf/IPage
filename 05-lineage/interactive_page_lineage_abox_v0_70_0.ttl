    backlog:hasParentItem pcl:Goal4_Mission ;
    backlog:producedByStage pcl:Out4_Goal2 ;
    rdfs:comment "Accepted by the Owner on 2026-11-08 about 20:50 Istanbul (ruling IP-R4)."@en .

pcl:Goal4_Mission a backlog:Goal ;
    rdfs:label "Every Delivery lineage of IPage runs on track to its mission: what it must obey is checked as it works, deviations are corrected when they appear, and the next one opens on a clear plan"@en ;

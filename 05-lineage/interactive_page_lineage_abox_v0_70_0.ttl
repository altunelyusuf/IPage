pcl:DomainEntity_PageConditions a backlog:DomainEntity ;
    rdfs:label "RDODI page conditions"@en ;
    skos:definition "The first-class thing this lineage is about: the Owner's conditions for interactive pages, made gates that every Stage 4 page must pass."^^xsd:string .

pcl:DomainEntity_PageOntology a backlog:DomainEntity ;
    rdfs:label "The ontology of interactive pages"@en ;
    skos:definition "The first-class thing this lineage is about: one stand-alone ontology of interactive pages, organised by kind, that carries the Owner's page rules and from which RDODI builds and checks its default page format."^^xsd:string .

pcl:Goal4_Handovers a backlog:Goal ;
    rdfs:label "Every session that wrote to IPage, and the framework IPage writes to, finds its question settled in its own inbox, so none waits on IPage"@en ;

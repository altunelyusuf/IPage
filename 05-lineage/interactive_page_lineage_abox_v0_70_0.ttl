pcl:Groom4_Execution_1 a backlog:RefinementEvent ;
    backlog:addressesConcern backlog:Concern_Architecture ;
    backlog:hasRefinementOutcome "Grooming step 1: its seven child epics are groomed into 13 stories; its score is the roll-up of theirs, 5.1607."^^xsd:string ;
    backlog:hasWorkKind backlog:WorkKind_Preparation ;
    backlog:refinedAt "2026-11-10T08:00:00+00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:refines pcl:Epic4_Execution .

pcl:Groom4_Handovers_1 a backlog:RefinementEvent ;
    backlog:addressesConcern backlog:Concern_Architecture ;
    backlog:hasRefinementOutcome "Grooming step 1 (ruling IP-R7): the epic is groomed into 4 stories, one for each deliverable it serves (D1, D2, D3, D4), each with a Given/When/Then criterion, an effort and a score; the epic's estimate is replaced by the roll-up of its stories, 5.525."^^xsd:string ;
    backlog:hasWorkKind backlog:WorkKind_Preparation ;
    backlog:refinedAt "2026-11-10T08:00:00+00:00"^^xsd:dateTime ;
    backlog:refinedBy backlog:Builder ;
    backlog:refines pcl:Epic4_Handovers .


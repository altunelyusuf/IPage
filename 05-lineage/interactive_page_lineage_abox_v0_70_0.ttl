pcl:Goal4_Conformance a backlog:Goal ;
    rdfs:label "IPage's register stays conformant to the framework, so every claim it makes can be checked"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:contributesToMission pcl:Mission_G4 ;
    backlog:decidedBy backlog:Owner ;
    backlog:derivesFromScope pcl:Scope4 ;
    backlog:hasGoalFacing backlog:Facing_Mission ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:isConformanceGoal true ;
    backlog:producedByStage pcl:Out4_Goal2 ;
    rdfs:comment "Accepted by the Owner on 2026-11-08 about 20:50 Istanbul (ruling IP-R4)."@en .

pcl:Goal4_Contained a backlog:Goal ;
    rdfs:label "No work is done here that the scope does not name"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:contributesToMission pcl:Mission_G4 ;
    backlog:decidedBy backlog:Owner ;
    backlog:derivesFromScope pcl:Scope4 ;
    backlog:hasGoalFacing backlog:Facing_Containment ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:producedByStage pcl:Out4_Goal2 ;
    rdfs:comment "Accepted by the Owner on 2026-11-08 about 20:50 Istanbul (ruling IP-R4)."@en .

pcl:Goal4_Guard_Branches a backlog:Goal ;
    rdfs:label "No governance branch without open work is taken up here"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;

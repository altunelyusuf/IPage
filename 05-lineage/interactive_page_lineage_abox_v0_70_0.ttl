        pcl:Del4_D19 ;
    backlog:hasIdentifier "IPG4-PKG-6"^^xsd:string ;
    backlog:hasPackageVersion "1.26.0"^^xsd:string ;
    backlog:hasRationale "Packed from groomed stories (ruling IP-R8). Priority: 5.33, 5.33, 3.33; last because it reads the results of the others. Cohesion: what is seen after work is done: every changed file traced, each deviation reported with its route to correction, deployments under a milestone. Technical need: built on package 2's check; the monitoring report reads every other check. Deployed when complete, under milestone 4; it releases as IPage 1.26.0, the release that closes its last box, as decided at identification."^^xsd:string ;
    backlog:hasRoadmapRank 6 ;
    backlog:rankedOnRoadmap pcl:Roadmap4 ;
    backlog:targetsIteration pcl:It4_6,
        pcl:It4_7 .


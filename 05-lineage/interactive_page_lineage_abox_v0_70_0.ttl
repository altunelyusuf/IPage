pcl:Obj4_Branches a backlog:Objective ;
    rdfs:label "Objective: Work items of Lineage 4 that serve no deliverable of its scope"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:contributesToGoal pcl:Goal4_Guard_Branches ;
    backlog:fillsScope pcl:Scope4 ;
    backlog:hasAchievementStatus backlog:Ach_Pending ;
    backlog:hasBaselineValue 0.0 ;
    backlog:hasCheckpoint pcl:CP4_Branches ;
    backlog:hasIntentOrigin backlog:IOrigin_Derived ;
    backlog:hasMeasurementKind backlog:Meas_Counted ;
    backlog:hasMeasurementQuery "python3 05-lineage/measure_governance_v1_1_0.py --metric Branches"^^xsd:string ;
    backlog:hasRationale "Baseline read by measure_governance_v1_0_0.py on IPage v1.14.0 (9d90e53); the figure counts what is still missing, so the target is 0."^^xsd:string,
        "Used at four moments (ruling IP-R6): driving, at each sprint plan, where the open figure helps choose the next work; monitoring, at each release, where the gate prints and records it; control, at each release, where a figure above 0 stops the release and is raised as an obstacle with its route to correction; closure, the last reading, where 0 is achieved and anything else is recorded as missed."^^xsd:string ;
    backlog:hasSuccessMetric pcl:Metric4_Branches ;
    backlog:hasTargetDirection backlog:Dir_Hold ;
    backlog:hasTargetValue 0.0 ;
    backlog:producedByStage pcl:Out4_Objective ;
    rdfs:comment "Correction, 2026-11-09: the measurement query now names measure_governance_v1_1_0.py, which replaced v1.0.0 when the Branches figure learnt to read through an epic's decomposition (a parent epic serves the deliverables its child epics serve). The other figures count the same way; the baseline was read with v1.0.0, as its observation says."@en .


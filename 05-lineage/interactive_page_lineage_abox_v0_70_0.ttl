pcl:Pkg4_P3 a backlog:Package ;
    rdfs:label "Package 3: A Delivery lineage is queued and starts ready"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:containerDependsOn pcl:Pkg4_P2 ;
    backlog:contributesToMilestone pcl:Milestone4_M2 ;
    backlog:deliversDeliverable pcl:Del4_D6,
        pcl:Del4_D8,
        pcl:Del4_D9 ;
    backlog:hasIdentifier "IPG4-PKG-3"^^xsd:string ;
    backlog:hasPackageVersion "1.22.0"^^xsd:string ;
    backlog:hasRationale "Packed from groomed stories (ruling IP-R8). Priority: the highest-scored story of the backlog (D6, 11.25) with the two that guard a start. Cohesion: what must hold before a Delivery lineage's first box: its place in the queue with its mission, the order, and its packages with a discussed forecast. Technical need: D8 and D9 are gate checks built on package 2. Deployed when complete, under milestone 2; it releases as IPage 1.22.0, the release that closes its last box, as decided at identification."^^xsd:string ;
    backlog:hasRoadmapRank 3 ;
    backlog:rankedOnRoadmap pcl:Roadmap4 ;
    backlog:targetsIteration pcl:It4_3 .


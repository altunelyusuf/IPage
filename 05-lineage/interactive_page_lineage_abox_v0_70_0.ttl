    backlog:hasTargetDate "2026-11-10T12:03:15+00:00"^^xsd:dateTime ;
    rdfs:comment "Its date is the forecast end of the last box of the packages it marks, due on nothing (G226, ruling IP-R6); it is achieved only when the work that contributes to it is Done."^^xsd:string ;

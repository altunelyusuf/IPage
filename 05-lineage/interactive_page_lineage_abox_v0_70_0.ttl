    backlog:hasPackageVersion "1.23.0"^^xsd:string ;
    backlog:hasRationale "Packed from groomed stories (ruling IP-R8). Priority: the next highest-scored gate stories (6.67, 5.33, 5.33). Cohesion: how a sprint's work is refined, executed with current statuses, closed by its Definition of Done and reviewed with carry-over. Technical need: built on package 2's check. Deployed when complete, under milestone 3; it releases as IPage 1.23.0, the release that closes its last box, as decided at identification."^^xsd:string ;
    backlog:hasRoadmapRank 4 ;
    backlog:rankedOnRoadmap pcl:Roadmap4 ;
    backlog:targetsIteration pcl:It4_4 .


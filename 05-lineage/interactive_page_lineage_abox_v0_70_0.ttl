pcl:Out4_Backlog a backlog:StageOutput ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:closedAtCommit "IPage v1.18.0 (release commit; witnessed by git, not asserted)"^^xsd:string ;
    backlog:consumesOutput pcl:Out4_Objective ;
    backlog:hasRationale "Backlog stage of Lineage 4 (rulings IP-R7, IP-R8; framework G228, G229): eleven epics from the scope tree, groomed in one step into 19 stories, one for each deliverable, each scored; each epic's estimate replaced by the roll-up of its stories. Packages, time-boxes and the deployment plan are the roadmap work that follows, before the first box."^^xsd:string,
        "Backlog stage of Lineage 4, closed in its own release; the digest is the framework's own state_digest over this stage's element types."^^xsd:string ;
    backlog:hasStateDigest "bbcc00728edd1670a224bc79d0e90c781c6424c860f58eb95564601f9e8cc173"^^xsd:string ;
    backlog:outputOfStage backlog:Stage_Backlog .


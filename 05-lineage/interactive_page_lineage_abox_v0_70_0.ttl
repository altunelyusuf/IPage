pcl:Commit01 a backlog:Commitment ;
    backlog:commitsToGoal pcl:Goal_Scope .

pcl:Commit03 a backlog:Commitment ;
    backlog:commitsToGoal pcl:Goal3_Mission .

pcl:DoD a backlog:DefinitionOfDone ;
    rdfs:label "RDODI page conditions - Definition of Done"@en ;
    rdfs:comment "A story is Done when its deliverable's condition holds on the pages as measured by the gate from a fresh clone of the published release, with evidence the framework's bridge re-verifies."^^xsd:string .

pcl:DoD4_1 a backlog:DoDCriterion ;
    rdfs:label "Every Done item of Lineage 4 has its evidence"@en ;
    backlog:hasCheckQuery "PREFIX b: <http://example.org/backlog#> ASK { ?s b:belongsToLineage <http://example.org/rdodi/page-conditions-lineage#Lineage04> ; b:hasState b:Done . ?s a ?k . FILTER (?k IN (b:Epic, b:Story, b:Task, b:ExecutionTask)) FILTER NOT EXISTS { ?s b:hasEvidence ?e } }"^^xsd:string ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "false" .

pcl:DoD4_2 a backlog:DoDCriterion ;
    rdfs:label "Every Done item of Lineage 4 is verified by an independent verifier"@en ;
    backlog:hasCheckQuery "PREFIX b: <http://example.org/backlog#> ASK { ?s b:belongsToLineage <http://example.org/rdodi/page-conditions-lineage#Lineage04> ; b:hasState b:Done . ?s a ?k . FILTER (?k IN (b:Epic, b:Story, b:Task, b:ExecutionTask)) FILTER NOT EXISTS { ?s b:verifiedBy ?e } }"^^xsd:string ;
    backlog:hasCriterionStatus backlog:Holds ;
    backlog:hasExpectedResult "false" .

pcl:Exec_Builder4 a backlog:Executor_SingleAgent ;
    rdfs:label "The building agent of Lineage 4: the session agent that writes its records and builds its gate checks"@en .

pcl:Fc4_A_Artifacts a backlog:Forecast ;
    backlog:forecastAssumption "The agents keep the pace observed in 10 pairs of consecutive boxes: 2.21 points per elapsed hour (median), buffer x1.5 (backlog_date_plan_v1_1_0.py). Pace taken from the framework's own register (backlog_abox_v1_199_0.ttl), because IPage's boxes carry no points. 39 points of the lineage's 48, counted in the planned order (hand-overs, queue, then the gate checks, 3 points each), are done when this objective's condition holds. Points are the session's planning estimates, set before refinement."^^xsd:string ;

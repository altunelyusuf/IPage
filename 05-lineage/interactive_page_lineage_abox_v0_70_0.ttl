pcl:Gap_PageConditions_ActiveUse a backlog:BlueprintGap ;
    rdfs:label "No live coverage: life-cycle stage Active use"@en ;
    backlog:gapForEntity pcl:DomainEntity_PageConditions ;
    backlog:gapForStage backlog:Stage_ActiveUse ;
    backlog:hasGapReason "Covered by the work of Lineage 2, which was set down in the archive with its items closed (IPage 1.13.0, ruling IP-R5). No live lineage covers this stage; the work carried forward goes to IPage's Delivery lineages."^^xsd:string .


pcl:Mission_G4 a backlog:Mission ;
    rdfs:label "Mission 4: IPage's lineages are governed so the next Delivery lineage opens on a clear plan"@en ;
    backlog:belongsToLineage pcl:Lineage04 ;
    backlog:decidedBy backlog:Owner ;
    backlog:hasMissionOrigin backlog:Origin_SessionDrafted ;
    backlog:hasMissionOutcome backlog:Out_InFlight ;
    backlog:hasMissionStatement "IPage's lineages are governed so the next Delivery lineage opens on a clear plan: every open hand-over is settled and delivered to its owner's inbox, Lineage 2 is set down, and the work carried forward from Lineage 3 is laid out as a roadmap of narrow Delivery lineages, each with its package, the repair of the rule checks first."^^xsd:string ;
    backlog:missionFor pcl:Backlog ;
    backlog:missionSource "Owner, 2026-11-08 16:05 Istanbul (13:05 UTC): 'Accept (Recommended)' to this mission, drafted by the session and put to him with its scope (the open hand-overs; setting down Lineage 2; the Delivery roadmap) and its exclusions (no change to the ontology, shapes or pages; no file outside IPage except hand-overs placed in a recipient's inbox), under his ruling IP-R1 of the same day."^^xsd:string ;
    backlog:producedByStage pcl:Out4_Mission ;
    rdfs:comment "DRAFT by an assistant session; accepted by the Owner on 2026-11-08 as worded."@en .


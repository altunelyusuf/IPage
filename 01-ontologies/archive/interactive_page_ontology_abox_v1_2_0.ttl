ipo:Instr_20 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 20 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 20."@en ;
    ipo:instructionText "Explanations must be comprehensive, cohesive paragraphs of full sentences fit for teaching, not single sentences." .

ipo:Rule_20 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Explanations are comprehensive, cohesive paragraphs of full sentences"@en ;
    skos:definition "Explanations are comprehensive, cohesive paragraphs of full sentences."@en ;
    ipo:ruleSource ipo:Instr_20 ;
    ipo:ofQuality ipo:Qual_Comp ;
    ipo:onPartKind ipo:SourceContent .

ipo:Instr_21 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 21 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 21."@en ;
    ipo:instructionText "The learn sections need visualizations and interactions, not rich text alone." .

ipo:Rule_21 a ipo:PageRule , owl:NamedIndividual ;

    ipo:ruleSource ipo:Instr_16 ;
    ipo:ofQuality ipo:Qual_Clear ;
    ipo:onPartKind ipo:NavigationAid .

ipo:Instr_17 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 17 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 17."@en ;
    ipo:instructionText "Choosing a low-level item in the left explorer opens that single item only, not its siblings." .

ipo:Rule_17 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Choosing a low-level item in the left explorer opens that single item, not its siblings"@en ;
    skos:definition "Choosing a low-level item in the left explorer opens that single item, not its siblings."@en ;
    ipo:ruleSource ipo:Instr_17 ;

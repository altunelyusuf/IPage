ipo:Instr_28 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 28 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 28."@en ;
    ipo:instructionText "Visualizations and interactions must be merged with the content, not appended; content must never hide behind a click a reader would only find by chance." .


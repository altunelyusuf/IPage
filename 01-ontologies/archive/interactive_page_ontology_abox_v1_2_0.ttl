ipo:Instr_11 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 11 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 11."@en ;
    ipo:instructionText "Interactive course HTML pages must be adaptive to any device and screen, usable on students' phones and filling large screens, scaling as the window is resized." .

ipo:Rule_11 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "The page adapts to any device and screen, from a phone to a large screen, and scales as the window is resized"@en ;
    skos:definition "The page adapts to any device and screen, from a phone to a large screen, and scales as the window is resized."@en ;
    ipo:ruleSource ipo:Instr_11 ;
    ipo:ofQuality ipo:Qual_Adapt ;
    ipo:onPartKind ipo:PageStructure .

ipo:Instr_12 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 12 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 12."@en ;
    ipo:instructionText "Default text must not be small." .

ipo:Rule_12 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Default text is not small"@en ;
    skos:definition "Default text is not small."@en ;
    ipo:ruleSource ipo:Instr_12 ;
    ipo:ofQuality ipo:Qual_Read ;
    ipo:onPartKind ipo:VisualPresentation .

ipo:Instr_13 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 13 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 13."@en ;
    ipo:instructionText "The page needs a reader-adjustable text-size control." .

ipo:Rule_13 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "The reader can adjust the text size"@en ;
    skos:definition "The reader can adjust the text size."@en ;
    ipo:ruleSource ipo:Instr_13 ;
    ipo:ofQuality ipo:Qual_Read ;
    ipo:onPartKind ipo:InteractiveControl .

ipo:Instr_14 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 14 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 14."@en ;
    ipo:instructionText "Zoom controls must never cover the diagram." .

ipo:Rule_14 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Zoom controls never cover the diagram"@en ;
    skos:definition "Zoom controls never cover the diagram."@en ;

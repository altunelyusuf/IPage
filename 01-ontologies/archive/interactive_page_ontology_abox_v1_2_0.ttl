ipo:Instr_16 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 16 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 16."@en ;
    ipo:instructionText "No third level of sub-tabs (use e.g. a breadcrumb)." .

ipo:Rule_16 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "There is no third level of sub-tabs; a breadcrumb is used instead"@en ;

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<http://example.org/rdodi/interactive-page-ontology/abox> a owl:Ontology ;
    rdfs:label "Interactive Page Ontology A-Box v1.2.0"@en ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:description "Reference individuals of the interactive page ontology: ten quality standards and methods, eleven page qualities, and the Owner's 28 page rules each with its source instruction, its quality and the kind of page part it concerns. The default page format and the profile-to-page map are added by the next stories."@en ;
    dcterms:identifier "interactive_page_ontology_abox_v1_2_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-05"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    owl:versionIRI <http://example.org/rdodi/interactive-page-ontology/abox/1.2.0> ;
    owl:versionInfo "1.2.0" ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> .

<http://example.org/rdodi/agent/YusufAltunel> a prov:Agent ; rdfs:label "Yusuf Altunel"@en .
<http://example.org/rdodi/agent/IstanbulKulturUniversity> a prov:Agent ; rdfs:label "Istanbul Kultur University"@en .

ipo:Std_WCAG22AA a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "WCAG 2.2 level AA"@en ;
    skos:definition "The Web Content Accessibility Guidelines 2.2 at level AA: the testable accessibility requirements a page has to meet."@en ;
    dcterms:source "https://www.w3.org/TR/WCAG22/" ;
    ipo:appliesTo ipo:PageStructure , ipo:NavigationAid , ipo:InteractiveControl , ipo:VisualPresentation , ipo:SourceContent .

ipo:Std_Nielsen10 a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "Nielsen's ten usability heuristics"@en ;
    skos:definition "Ten broad rules of thumb for judging how usable an interface is."@en ;
    dcterms:source "https://www.nngroup.com/articles/ten-usability-heuristics/" ;
    ipo:appliesTo ipo:InteractiveControl , ipo:NavigationAid , ipo:PageStructure .

ipo:Std_Shneiderman8 a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "Shneiderman's eight golden rules of interface design"@en ;
    skos:definition "Eight rules for dialogue design such as consistency, feedback and easy reversal of actions."@en ;
    dcterms:source "https://www.cs.umd.edu/users/ben/goldenrules.html" ;
    ipo:appliesTo ipo:InteractiveControl , ipo:NavigationAid .

ipo:Std_CognitiveLoad a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "Cognitive load theory"@en ;
    skos:definition "The finding that learners can hold little new information at once, so a teaching page should limit what it shows at one time."@en ;
    dcterms:source "https://en.wikipedia.org/wiki/Cognitive_load" ;
    ipo:appliesTo ipo:LearningElement , ipo:PageStructure , ipo:VisualPresentation .

ipo:Std_AxeCore a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "axe-core accessibility checker"@en ;
    skos:definition "An open-source engine that tests a rendered page automatically against accessibility rules."@en ;
    dcterms:source "https://github.com/dequelabs/axe-core" ;
    ipo:appliesTo ipo:PageStructure , ipo:InteractiveControl , ipo:VisualPresentation .

ipo:Std_Pa11y a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "pa11y accessibility checker"@en ;
    skos:definition "An open-source command-line tool that runs accessibility tests on a page."@en ;
    dcterms:source "https://github.com/pa11y/pa11y" ;
    ipo:appliesTo ipo:PageStructure , ipo:InteractiveControl , ipo:NavigationAid , ipo:VisualPresentation .

ipo:Std_WAVE a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "WAVE accessibility evaluation tool"@en ;
    skos:definition "A tool that marks accessibility problems directly on the page for a human to review."@en ;
    dcterms:source "https://wave.webaim.org/" ;
    ipo:appliesTo ipo:VisualPresentation , ipo:PageStructure , ipo:InteractiveControl .

ipo:Std_WAIARIA a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "WAI-ARIA"@en ;
    skos:definition "The W3C specification of roles and states that let assistive technology understand custom controls."@en ;
    dcterms:source "https://www.w3.org/TR/wai-aria/" ;
    ipo:appliesTo ipo:InteractiveControl , ipo:NavigationAid , ipo:PageStructure .

ipo:Std_InclusiveComponents a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "Inclusive Components"@en ;
    skos:definition "A pattern collection by Heydon Pickering on building widgets everyone can use."@en ;
    dcterms:source "https://inclusive-components.design/" ;
    ipo:appliesTo ipo:InteractiveControl , ipo:NavigationAid .

ipo:Std_ISO25010 a ipo:QualityStandard , owl:NamedIndividual ;
    rdfs:label "ISO/IEC 25010 product quality model"@en ;
    skos:definition "The international model that names the quality characteristics of a software product, such as usability and compatibility."@en ;
    dcterms:source "https://iso25000.com/index.php/en/iso-25000-standards/iso-25010" ;
    ipo:appliesTo ipo:PageStructure , ipo:DeliveryTechnology , ipo:InteractiveControl , ipo:NavigationAid .

ipo:Qual_Pred a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "predictable"@en ;
    skos:definition "The page does what the reader expects when he acts."@en .

ipo:Qual_Work a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "working behaviour"@en ;
    skos:definition "What the page shows really works: code runs, controls act."@en .

ipo:Qual_Spec a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "specific answers"@en ;
    skos:definition "Each part answers from its own slice of the ontology and corpus."@en .

ipo:Qual_Nav a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "navigable"@en ;
    skos:definition "The reader finds content and moves through it without effort."@en .

ipo:Qual_Read a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "readable"@en ;
    skos:definition "Text and diagrams can be read and enlarged comfortably."@en .

ipo:Qual_Adapt a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "adaptable"@en ;
    skos:definition "The page fits any device and screen."@en .

ipo:Qual_Econ a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "economy of space"@en ;
    skos:definition "Screen space, above all the top, is spent on content."@en .

ipo:Qual_Clear a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "clear structure"@en ;
    skos:definition "Parts are ordered, not repeated and kept in step."@en .

ipo:Qual_Comp a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "comprehensible"@en ;
    skos:definition "Every term is explained so the page teaches on its own."@en .

ipo:Qual_Eng a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "engaging"@en ;
    skos:definition "Learning is carried by visualization and interaction."@en .

ipo:Qual_Focus a ipo:PageQuality , owl:NamedIndividual ;
    rdfs:label "focused content"@en ;
    skos:definition "Content is content; guidance about the work is not shown as content."@en .

ipo:Instr_01 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 1 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 1."@en ;
    ipo:instructionText "Menu clicks change the main area first." .

ipo:Rule_01 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Menu clicks change the main area first"@en ;
    skos:definition "Menu clicks change the main area first."@en ;
    ipo:ruleSource ipo:Instr_01 ;
    ipo:ofQuality ipo:Qual_Pred ;
    ipo:onPartKind ipo:NavigationAid .

ipo:Instr_02 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 2 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 2."@en ;
    ipo:instructionText "The right-hand detail card appears only when a detail is explicitly requested." .

ipo:Rule_02 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "The right-hand detail card appears only when a detail is explicitly requested"@en ;
    skos:definition "The right-hand detail card appears only when a detail is explicitly requested."@en ;
    ipo:ruleSource ipo:Instr_02 ;
    ipo:ofQuality ipo:Qual_Pred ;
    ipo:onPartKind ipo:InteractiveControl .

ipo:Instr_03 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 3 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 3."@en ;
    ipo:instructionText "Tab menus are always sub-menus of the selected top-level item, never mixed with it." .

ipo:Rule_03 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Tab menus are always sub-menus of the selected top-level item, never mixed with it"@en ;
    skos:definition "Tab menus are always sub-menus of the selected top-level item, never mixed with it."@en ;
    ipo:ruleSource ipo:Instr_03 ;
    ipo:ofQuality ipo:Qual_Clear ;
    ipo:onPartKind ipo:NavigationAid .

ipo:Instr_04 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 4 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 4."@en ;
    ipo:instructionText "Code on the page must really run (edited code changes the result)." .

ipo:Rule_04 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Code on the page really runs: edited code changes the result"@en ;
    skos:definition "Code on the page really runs: edited code changes the result."@en ;
    ipo:ruleSource ipo:Instr_04 ;
    ipo:ofQuality ipo:Qual_Work ;
    ipo:onPartKind ipo:LearningElement .

ipo:Instr_05 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 5 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 5."@en ;
    ipo:instructionText "Subject agents must answer from their own slice of the ontology and corpus, not give generic identical answers." .

ipo:Rule_05 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Subject agents answer from their own slice of the ontology and corpus, not with generic identical answers"@en ;
    skos:definition "Subject agents answer from their own slice of the ontology and corpus, not with generic identical answers."@en ;
    ipo:ruleSource ipo:Instr_05 ;
    ipo:ofQuality ipo:Qual_Spec ;
    ipo:onPartKind ipo:LearningElement .

ipo:Instr_06 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 6 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 6."@en ;
    ipo:instructionText "Every diagram needs zoom in/out, a full-screen view and a resizable panel." .

ipo:Rule_06 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Every diagram has zoom in and out, a full-screen view and a resizable panel"@en ;
    skos:definition "Every diagram has zoom in and out, a full-screen view and a resizable panel."@en ;
    ipo:ruleSource ipo:Instr_06 ;
    ipo:ofQuality ipo:Qual_Read ;
    ipo:onPartKind ipo:InteractiveControl .

ipo:Instr_07 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 7 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 7."@en ;
    ipo:instructionText "Keep the top-level menu uncrowded." .

ipo:Rule_07 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "The top-level menu stays uncrowded"@en ;
    skos:definition "The top-level menu stays uncrowded."@en ;
    ipo:ruleSource ipo:Instr_07 ;
    ipo:ofQuality ipo:Qual_Econ ;
    ipo:onPartKind ipo:NavigationAid .

ipo:Instr_08 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 8 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 8."@en ;
    ipo:instructionText "No duplicated lists on a screen." .

ipo:Rule_08 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "No list is shown twice on one screen"@en ;
    skos:definition "No list is shown twice on one screen."@en ;
    ipo:ruleSource ipo:Instr_08 ;
    ipo:ofQuality ipo:Qual_Clear ;
    ipo:onPartKind ipo:PageStructure .

ipo:Instr_09 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 9 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 9."@en ;
    ipo:instructionText "Move static explanations into their own sub-tabs or the detail card." .

ipo:Rule_09 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Static explanations live in their own sub-tabs or in the detail card"@en ;
    skos:definition "Static explanations live in their own sub-tabs or in the detail card."@en ;
    ipo:ruleSource ipo:Instr_09 ;
    ipo:ofQuality ipo:Qual_Clear ;
    ipo:onPartKind ipo:PageStructure .

ipo:Instr_10 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 10 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 10."@en ;
    ipo:instructionText "Taxonomy drawn as one connected tree with labels fitting their boxes." .

ipo:Rule_10 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "A taxonomy is drawn as one connected tree with labels that fit their boxes"@en ;

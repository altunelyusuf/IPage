ipo:Instr_25 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 25 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 25."@en ;
    ipo:instructionText "Content and visualizations must fit the direct display without scrolling." .

ipo:Rule_25 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Content and visualizations fit the display without scrolling"@en ;

ipo:Instr_15 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 15 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 15."@en ;
    ipo:instructionText "Touching a content element should show its options first, preferably in the right-hand detail card, rather than jumping elsewhere (direct navigation stays for menus)." .

ipo:Rule_15 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Touching a content element shows its options first, preferably in the right-hand card"@en ;
    skos:definition "Touching a content element shows its options first, preferably in the right-hand card."@en ;

    rdfs:label "Owner instruction 24 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 24."@en ;
    ipo:instructionText "The ontology graph must show its syntactic, semantic and behavioural categorizations." .


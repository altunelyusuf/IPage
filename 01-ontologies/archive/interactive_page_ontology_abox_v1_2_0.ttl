ipo:Instr_18 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 18 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 18."@en ;
    ipo:instructionText "Tabs and the left hierarchical explorer must always stay synchronized." .

ipo:Rule_18 a ipo:PageRule , owl:NamedIndividual ;

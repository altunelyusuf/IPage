ipo:Instr_19 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 19 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 19."@en ;
    ipo:instructionText "Every term and tool used must itself be explained." .

ipo:Rule_19 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Every term and tool used on the page is explained"@en ;

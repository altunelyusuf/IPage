ipo:Instr_26 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 26 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 26."@en ;
    ipo:instructionText "Meta information about the work itself (where, who, etc.) is guidance only, never visualized in the content." .

ipo:Rule_26 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "Meta information about the work itself is guidance only and is never shown as content"@en ;
    skos:definition "Meta information about the work itself is guidance only and is never shown as content."@en ;
    ipo:ruleSource ipo:Instr_26 ;
    ipo:ofQuality ipo:Qual_Focus ;
    ipo:onPartKind ipo:SourceContent .

ipo:Instr_27 a ipo:OwnerInstruction , owl:NamedIndividual ;
    rdfs:label "Owner instruction 27 on interactive pages"@en ;
    skos:definition "The Owner's recorded instruction on interactive course pages that gives page rule 27."@en ;
    ipo:instructionText "The top of the screen is the most valuable area and must never be spent cheaply; use tool tips instead of messages and accordions wherever possible, short, with details in the right-hand card." .

ipo:Rule_27 a ipo:PageRule , owl:NamedIndividual ;
    rdfs:label "The top of the screen is never spent cheaply: tooltips replace messages and accordions, with details in the right-hand card"@en ;
